{
  "name": "CareFlow Backend",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "CareFlow Demo",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "if ! command -v uv >/dev/null 2>&1; then pipx install uv; fi && uv sync --locked --extra dev --extra speech",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "합성 대화로 Claude 실호출을 검증할 때만 사용하는 개인 Anthropic API 키",
      "documentationUrl": "https://platform.claude.com/settings/keys"
    }
  }
}
