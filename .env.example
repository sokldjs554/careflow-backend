ENVIRONMENT=local
AUTO_CREATE_SCHEMA=true
DATABASE_URL=sqlite+aiosqlite:///./careflow.db
REDIS_URL=
TRANSCRIPT_TTL_SECONDS=1800
MAX_CHUNK_CHARS=2000
NOTE_GENERATOR_MODE=anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=60
SPEECH_RECOGNITION_MODE=faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
SPEECH_MAX_AUDIO_BYTES=10000000
SPEECH_MAX_DURATION_SECONDS=45
